# 로컬 개발용 — .env.local로 복사해서 값 채우기 (.env.local은 gitignore됨, 커밋 금지)

# 앱이 캔들·뉴스·경제지표 JSON을 가져올 base URL (Supabase Storage `data` 버킷 public URL)
# 미설정 시 /data 폴백 — public/data/에 파일이 있어야 함 (배포는 Vercel env에 설정)
NEXT_PUBLIC_DATA_URL=https://<project>.supabase.co/storage/v1/object/public/data/

# 로그인·기록 동기화(R11)용 — 미설정 시 로그인 UI가 숨고 local-first로만 동작
# 셋업: supabase/schema.sql 실행 + Dashboard에서 Kakao/Google provider 활성화 (README 참조)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sb_publishable_...>
# Vercel에서는 위 이름을 Supabase 통합이 (다른 프로젝트 값으로) 선점 중 — 아래 수동 변수가 우선 적용됨
# NEXT_PUBLIC_SB_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SB_ANON_KEY=<sb_publishable_...>

# 파이프라인 수동 실행용 (python은 이 파일을 안 읽음 — env로 직접 전달)
# 미설정이면 로컬 public/data/에만 기록. GitHub Actions에서는 Secrets로 주입됨
#   SUPABASE_URL=https://<project>.supabase.co SUPABASE_SERVICE_KEY=<sb_secret_...> python scripts/fetch-data.py
